# Build outputs. Artifacts are deployed as a Pages artifact, never committed:
# a Pages-served Git LFS file returns the pointer text, not the file, and the
# 100 MiB per-file block ends the discussion anyway.
build/
web/data/

# Ingest working set (~1.5 GB) and downloaded snapshot shards.
data/cache/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/

# Tooling
.playwright-mcp/
.DS_Store
